PORT=3000
NODE_ENV=development
# Required when NODE_ENV=production — without it, CORS reflects any origin
# with credentials enabled.
APP_ORIGIN=http://localhost:5173
API_PREFIX=/api
# Express "trust proxy" setting — leave unset locally (no proxy trusted).
# In production behind a reverse proxy, set to the real hop count (e.g. "1")
# or the proxy's IP/CIDR, so X-Forwarded-For can't be spoofed by clients.
# Rate limiting and the per-IP login lockout both bucket by request.ip, so a
# wrong value here either lumps every client together or lets them spoof it.
TRUST_PROXY=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/espera
REDIS_URL=redis://localhost:6379

# Access token: signed JWT, short-lived. The refresh token is an opaque
# random string stored hashed in the database, so it needs no secret of its
# own; its lifetime is fixed in code (30 days sliding, 90 days absolute —
# see JWTTokenService and RefreshTokenUseCase).
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
COOKIE_SECRET=replace-with-a-long-random-string
# Optional: the domain the auth cookies are scoped to (leave unset to use the
# request's own host).
COOKIE_DOMAIN=localhost

# Optional: Google sign-in. GOOGLE_CLIENT_BUSINESS_ID/SECRET work as
# fallbacks for the two below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/oauth/google/callback
# Optional: only used to build map links for a business address.
GOOGLE_MAPS_API_KEY=

# Required to send email (verification, password reset, approval notices).
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=noreply@espera.app
APP_URL=http://localhost:5173

LOG_LEVEL=info

# Only for `npm run test:integration:setup`; defaults to the URL below.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/espera_test
