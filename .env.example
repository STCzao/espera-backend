PORT=3000
NODE_ENV=development
# Required when NODE_ENV=production — without it, CORS reflects any origin
# with credentials enabled.
APP_ORIGIN=http://localhost:5173
API_PREFIX=/api
# Express "trust proxy" setting — leave unset locally (no proxy trusted).
# In production behind a reverse proxy, set to the real hop count (e.g. "1")
# or the proxy's IP/CIDR, so X-Forwarded-For can't be spoofed by clients.
TRUST_PROXY=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/espera
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=replace-with-a-long-random-string
COOKIE_DOMAIN=localhost

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/oauth/google/callback
GOOGLE_MAPS_API_KEY=
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=noreply@espera.app
APP_URL=http://localhost:5173

FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
LOG_LEVEL=info
