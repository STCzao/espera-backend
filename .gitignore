yarn-error.log*
pnpm-debug.log*

# Environment variables
.env
.env.local
.env.development
.env.test
.env.production
.env*.local
.env.*

# Build output
dist/
build/
out/

# Logs
logs/
*.log

# Runtime
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# Cache
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Uploads / generated files
uploads/
tmp/
temp/

# Prisma
prisma/migrations/dev.db
*.db

# Firebase / FCM
*-firebase-adminsdk-*.json
firebase-credentials.json

# Datos de la base local (bind mount de docker-compose)
data/

# Dumps y backups
backups/
*.archive
*.tar.gz
*.dump
# Los dumps son .sql, pero las migraciones de Prisma tambien: son codigo
# fuente y sin ellas `prisma migrate deploy` no puede reconstruir la base en
# produccion. Se ignoran los .sql sueltos y se rescatan las migraciones.
*.sql
!prisma/migrations/**/*.sql
